# Build output (regenerated by appimage-builder, don't commit)
#AppDir/
appimage-build/
*.AppImage

# The appimage-builder tool binary itself — download it separately, don't version it
appimage-builder-*.AppImage

# Never commit game dumps, keys, or NAND backups
*.iso
*.wbfs
*.rvz
keys.bin
nand.bin

# Compiled binaries
setup
$bootmii_nand_import
*.o

# Editor/OS cruft
.vscode/
*.swp
.DS_Store
